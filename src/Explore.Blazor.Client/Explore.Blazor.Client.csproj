<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <NswagSchema>$(MSBuildProjectDirectory)/../../schemas/openapi_islamu.json</NswagSchema>
    <NswagConfig>$(MSBuildProjectDirectory)/nswag.json</NswagConfig>
    <NswagClientOutput>$(MSBuildProjectDirectory)/Clients/IslamuApiClient.g.cs</NswagClientOutput>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Blazored.FluentValidation" />
    <PackageReference Include="Blazouter" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Refit.HttpClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Clients/IslamuApiClient.g.cs" />
  </ItemGroup>

  <Target Name="GenerateIslamuApiClient"
          BeforeTargets="CoreCompile"
          Inputs="$(NswagConfig);$(NswagSchema)"
          Outputs="$(NswagClientOutput)">
    <Error Condition="!Exists('$(NswagSchema)')"
           Text="Canonical OpenAPI schema not found: $(NswagSchema). Build Explore.API first to produce schemas/openapi_islamu.json." />
    <Exec Command="dotnet tool run nswag run &quot;$(NswagConfig)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Remove="$(NswagClientOutput)" />
      <Compile Include="$(NswagClientOutput)" Condition="Exists('$(NswagClientOutput)')" />
    </ItemGroup>
  </Target>

</Project>
