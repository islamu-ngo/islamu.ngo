@* ABOUTME: About Us page providing an overview of ISLAMU and this website's purpose.
   ABOUTME: Static informational page accessible at /about. *@

@page "/about"

<PageTitle>About Us — ISLAMU</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4" Style="font-weight: 800;">About Us</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-8">
        Learn more about ISLAMU and this website.
    </MudText>

    <section class="mb-8">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3" Style="font-weight: 700;">Our Mission</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            This website is ISLAMU's digital front door: a place to explain the mission, publish trustworthy
            content, and help people participate in community work as implemented services become available.
        </MudText>
    </section>

    <section class="mb-8">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3" Style="font-weight: 700;">What We Offer</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            A central place for ISLAMU information, public content, contact paths, and community participation
            features that are ready to use.
        </MudText>
    </section>

    <section class="mb-8">
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3" Style="font-weight: 700;">Our Values</MudText>
        <MudStack Spacing="2" Class="mb-4">
            <MudText Typo="Typo.body1"><strong>Inclusivity</strong> — Everyone is welcome, regardless of background or ability.</MudText>
            <MudText Typo="Typo.body1"><strong>Transparency</strong> — We operate openly and honestly with our community.</MudText>
            <MudText Typo="Typo.body1"><strong>Community</strong> — We put the needs of our community first.</MudText>
            <MudText Typo="Typo.body1"><strong>Quality</strong> — We are committed to delivering a great experience.</MudText>
        </MudStack>
    </section>

    <MudDivider Class="mb-8" />

    <MudText Typo="Typo.body2" Color="Color.Secondary">
        For more information or to get in touch, please visit our
        <MudLink Href="/contact" Color="Color.Primary">Contact</MudLink> page.
    </MudText>
</MudContainer>
