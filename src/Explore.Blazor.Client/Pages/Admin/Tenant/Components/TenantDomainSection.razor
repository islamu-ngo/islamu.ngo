@* ABOUTME: Renders tenant domain settings for the Tenant Admin Settings sidebar. *@
@* ABOUTME: Includes subdomain and custom domain fields with instance-level lock support. *@

@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Domains</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Configure your tenant's subdomain and custom domain.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudTextField T="string" Label="Subdomain"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.Subdomain"
                      Disabled="@(Model.CanOverrideSubdomain != true)"
                      HelperText="@($"{Model.Subdomain}.{Model.InstanceBaseDomain}")" />

        <MudTextField T="string" Label="Custom Domain"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.CustomDomain"
                      Disabled="@(Model.CanOverrideCustomDomain != true)"
                      Placeholder="custom.yourdomain.com" />
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public TenantPolicySettingsDto Model { get; set; } = null!;
}
