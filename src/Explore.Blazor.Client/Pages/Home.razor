@using Microsoft.AspNetCore.Components.Authorization
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Pages.Landing
@using Explore.Blazor.Client.Services
@using Microsoft.Extensions.Logging
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Home> Logger
@inject NavigationManager Navigation
@inject IPublicExperienceService PublicExperienceService

<PageTitle>@HomePageTitle</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrlHelper.Build(Navigation)" />
</HeadContent>

@if (isLoading)
{
    <div class="py-8">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mb-12">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-8 text-center">
                <MudSkeleton Width="200px" Height="16px" Class="mb-2" />
                <MudSkeleton Width="460px" Height="48px" Class="mb-2" />
                <MudSkeleton Width="360px" Height="24px" />
            </MudStack>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-xl" />
        </MudContainer>

        <MudContainer MaxWidth="MaxWidth.Large" Class="mb-16">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-12 text-center">
                <MudSkeleton Width="140px" Height="32px" Class="mb-2" />
                <MudSkeleton Width="300px" Height="20px" />
            </MudStack>
            <MudGrid Spacing="4">
                @for (int i = 0; i < 3; i++)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default d-flex flex-column align-center">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="80px" Height="80px" Class="mb-6" />
                            <MudSkeleton Width="60%" Height="24px" Class="mb-2" />
                            <MudSkeleton Width="90%" Height="16px" />
                            <MudSkeleton Width="80%" Height="16px" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </div>
}
else if (IsOrganizationCentricMode && !IsOrganizationHomeAvailable)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="organization-home py-8">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="organization-home__remediation rounded-xl pa-6">
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Organization home is not available yet</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">
                This site is using organization-first public experience, but the primary organization is @PrimaryOrganizationStateLabel.
                The public organization profile will appear here once its configuration is complete.
            </MudText>
        </MudAlert>
    </MudContainer>
}
else if (IsOrganizationHomeAvailable)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="organization-home py-8">
        <MudPaper Elevation="0" Class="organization-home__hero rounded-xl pa-8 pa-md-12 mb-8">
            <MudGrid AlignItems="AlignItems.Center" Spacing="6">
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h2" HtmlTag="h1" Class="organization-home__title mb-4">
                        @HeroTitle
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(HeroBody))
                    {
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="organization-home__summary mb-6">
                            @HeroBody
                        </MudText>
                    }
                    <MudStack Row="true" Spacing="2" Class="organization-home__actions flex-wrap">
                        @foreach (var cta in HeroCtas)
                        {
                            <MudButton Elevation="0" @key="cta.Key" Href="@cta.Url" Variant="@MapButtonVariant(cta.Style)" Color="Color.Primary" Class="rounded-pill">
                                @cta.Label
                            </MudButton>
                        }
                    </MudStack>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization?.ProfilePictureUri))
                {
                    <MudItem xs="12" md="4" Class="d-flex justify-center">
                        <MudAvatar Image="@_shell.PrimaryOrganization.ProfilePictureUri" Size="Size.Large" Class="organization-home__avatar" />
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @if (ContentBlocks.Count > 0)
        {
            <MudGrid Spacing="4" Class="mb-8">
                @foreach (var block in ContentBlocks)
                {
                    <MudItem @key="block.Key" xs="12" md="6">
                        <MudPaper Elevation="0" Class="organization-home__block pa-6 rounded-xl h-100">
                            <MudText Typo="Typo.overline" Color="Color.Primary">@block.Kind</MudText>
                            <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-2">@block.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(block.Subtitle))
                            {
                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">@block.Subtitle</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(block.Body))
                            {
                                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">@block.Body</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(block.LinkUrl) && !string.IsNullOrWhiteSpace(block.LinkText))
                            {
                                <MudButton Elevation="0" Color="Color.Primary" Href="@block.LinkUrl" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">
                                    @block.LinkText
                                </MudButton>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (HasContactOrFooterProjection)
        {
            <MudGrid Spacing="4" Class="mb-8">
                <MudItem xs="12" md="5">
                    <MudPaper Elevation="0" Class="organization-home__block pa-6 rounded-xl h-100">
                        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-2">Connect with @OrganizationName</MudText>
                        @if (!string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization.Handle))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@_shell.PrimaryOrganization.Handle</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization.WebsiteUrl))
                        {
                            <MudButton Elevation="0" Color="Color.Primary" Href="@_shell.PrimaryOrganization.WebsiteUrl" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.OpenInNew">
                                Visit website
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>
                @if (FooterLinkGroups.Count > 0)
                {
                    <MudItem xs="12" md="7">
                        <MudPaper Elevation="0" Class="organization-home__block pa-6 rounded-xl h-100">
                            <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Helpful links</MudText>
                            <MudGrid Spacing="3">
                                @foreach (var group in FooterLinkGroups)
                                {
                                    <MudItem @key="group.Id" xs="12" sm="6">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">@group.Title</MudText>
                                        <MudStack Spacing="1">
                                            @foreach (var link in (group.Links ?? []).OrderBy(link => link.Order).ThenBy(link => link.Label, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <MudLink @key="link.Id" Href="@link.Url" Target="@(link.OpenInNewTab == true ? "_blank" : null)">
                                                    @link.Label
                                                </MudLink>
                                            }
                                        </MudStack>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (!HasShellContent)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="organization-home__empty">
                This organization home is ready. Add public sections or calls to action to share community information.
            </MudAlert>
        }
    </MudContainer>
}
else if (isAuthenticated)
{
    <LandingPageForNonUsers />
}
else
{
    <LandingPageForNonUsers />
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private PublicExperienceShellDto? _shell;

    private string HomePageTitle => string.IsNullOrWhiteSpace(_shell?.Home?.BrandDisplayName)
        ? "ISLAMU"
        : _shell.Home.BrandDisplayName;

    private bool IsOrganizationCentricMode => _shell?.Mode == PublicExperienceMode.OrganizationCentric;

    private bool IsOrganizationHomeAvailable => IsOrganizationCentricMode
        && _shell?.PrimaryOrganization?.State == PublicExperiencePrimaryOrganizationState.Available;

    private string PrimaryOrganizationStateLabel => _shell?.PrimaryOrganization?.State switch
        {
            null or PublicExperiencePrimaryOrganizationState.NotConfigured => "not configured",
            PublicExperiencePrimaryOrganizationState.HiddenOrInactive => "hidden or inactive",
            PublicExperiencePrimaryOrganizationState.CrossTenantInvalid => "not available for this tenant",
            PublicExperiencePrimaryOrganizationState.ActorUnavailable => "missing its public profile",
            var state => state.ToString().ToLowerInvariant()
        };

    private string OrganizationName => string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization?.DisplayName)
        ? _shell?.Home?.BrandDisplayName ?? "This organization"
        : _shell.PrimaryOrganization.DisplayName;

    private PublicExperienceHomeBlockDto? HeroBlock => _shell?.Home?.Blocks?
        .Where(block => block.Kind is PublicExperienceHomeBlockKind.Hero
            or PublicExperienceHomeBlockKind.OrganizationSummary)
        .OrderBy(block => block.SortOrder)
        .FirstOrDefault();

    private string HeroTitle => string.IsNullOrWhiteSpace(HeroBlock?.Title)
        ? OrganizationName
        : HeroBlock.Title;

    private string HeroBody => string.IsNullOrWhiteSpace(HeroBlock?.Body)
        ? $"Explore community updates from {OrganizationName}."
        : HeroBlock.Body;

    private IReadOnlyList<PublicExperienceHomeBlockDto> ContentBlocks => _shell?.Home?.Blocks?
        .Where(block => block != HeroBlock)
        .OrderBy(block => block.SortOrder)
        .ThenBy(block => block.Title, StringComparer.OrdinalIgnoreCase)
        .ToList() ?? [];

    private IReadOnlyList<PublicExperienceCtaDto> HeroCtas => _shell?.Ctas?
        .Where(cta => !string.IsNullOrWhiteSpace(cta.Label) && !string.IsNullOrWhiteSpace(cta.Url))
        .OrderBy(cta => cta.SortOrder)
        .ThenBy(cta => cta.Label, StringComparer.OrdinalIgnoreCase)
        .Take(2)
        .ToList() ?? [];

    private bool HasShellContent => ContentBlocks.Count > 0 || HeroCtas.Count > 0;

    private IReadOnlyList<FooterLinkGroupDto> FooterLinkGroups => _shell?.Footer?.LinkGroups?
        .Where(group => !string.IsNullOrWhiteSpace(group.Title)
            && group.Links?.Any(link => !string.IsNullOrWhiteSpace(link.Label) && !string.IsNullOrWhiteSpace(link.Url)) == true)
        .OrderBy(group => group.Order)
        .ThenBy(group => group.Title, StringComparer.OrdinalIgnoreCase)
        .ToList() ?? [];

    private bool HasContactOrFooterProjection => !string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization?.WebsiteUrl)
        || !string.IsNullOrWhiteSpace(_shell?.PrimaryOrganization?.Handle)
        || FooterLinkGroups.Count > 0;

    [PersistentState]
    public HomeState? PersistedState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var shellTask = PublicExperienceService.GetCachedShellAsync();
            Task<AuthenticationState>? authStateTask = PersistedState is null
                ? AuthenticationStateProvider.GetAuthenticationStateAsync()
                : null;

            _shell = shellTask is null ? null : await shellTask;
            if (authStateTask is null)
            {
                isAuthenticated = PersistedState?.IsAuthenticated ?? false;
            }
            else
            {
                var authState = await authStateTask;
                isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            }

        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auth check failed");
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
            PersistedState = new HomeState { IsAuthenticated = isAuthenticated };
        }
    }

    public sealed class HomeState
    {
        public bool IsAuthenticated { get; init; }
    }

    private static Variant MapButtonVariant(PublicExperienceCtaStyle? style)
    {
        return style is PublicExperienceCtaStyle.Secondary or PublicExperienceCtaStyle.Text
                ? Variant.Outlined
                : Variant.Filled;
    }

}
