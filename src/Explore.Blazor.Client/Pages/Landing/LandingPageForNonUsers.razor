@* ABOUTME: Public welcome page for visitors who have not signed in. *@
@* ABOUTME: Introduces the community and provides account entry points without product-specific discovery content. *@
@using Explore.Blazor.Client.Helpers
@inject NavigationManager Navigation

<PageTitle>Welcome</PageTitle>
@if (IsWelcomeRoute)
{
    <HeadContent>
        <link rel="canonical" href="@CanonicalUrlHelper.Build(Navigation, "/welcome")" />
    </HeadContent>
}

<div class="py-8">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-12">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-8 text-center">
            <MudText Typo="Typo.overline" Color="Color.Primary">COMMUNITY • CONNECTION • GROWTH</MudText>
            <MudText Typo="Typo.h2" HtmlTag="h1">Grow with your Muslim community</MudText>
            <MudText Typo="Typo.h6" Color="Color.Secondary">
                Connect with people and organizations working together for faith, service, and belonging.
            </MudText>
        </MudStack>

        <MudPaper Elevation="0" Class="rounded-xl overflow-hidden border-solid border-1 mud-border-lines-default">
            <MudGrid>
                <MudItem xs="12" md="6" Class="pa-8 d-flex flex-column justify-center align-start">
                    <MudText Typo="Typo.h4" Class="mb-4">Join the community</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                        Create an account to manage your profile and connect with community organizations and groups.
                    </MudText>
                    <div class="d-flex gap-4 flex-wrap">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/login" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd" Class="rounded-pill px-8 py-3">Create Account</MudButton>
                        <MudButton Elevation="0" Href="/login" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login" Class="rounded-pill px-8 py-3">Log In</MudButton>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6" Class="relative" Style="min-height: 400px;">
                    <div style="position: absolute; inset: 0; background: url('image/landing_image_nonuser.png') no-repeat center center / cover;"></div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-16">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">Knowledge & Faith</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Learn and grow through trusted community relationships.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">Meet & Connect</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Build meaningful local connections and collaborate with others.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">Serve Together</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Support charitable and community-building initiatives.</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    private bool IsWelcomeRoute => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/welcome", StringComparison.OrdinalIgnoreCase);
}
