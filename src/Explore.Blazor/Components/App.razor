@* ABOUTME: Root Blazor host document that wires render mode, CSP, auth state, and routing.
   ABOUTME: Provides global error-boundary fallback UI and logs unhandled component exceptions. *@
@using Explore.Blazor.Components.ControlPlane
@using Explore.Blazor.Client.Layout
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Cryptography
@inject IHttpContextAccessor HttpContextAccessor
@inject AdminHostControlPlaneShellSelector AdminHostShellSelector
@inject IRuntimeRenderPolicyService RuntimeRenderPolicyService
@inject ILogger<App> Logger

@{
    var cspNonce = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));
    var csp = string.Join(" ",
        "default-src 'self';",
        $"script-src 'self' 'unsafe-hashes' 'sha256-qnHnQs7NjQNHHNYv/I9cW+I62HzDJjbnyS/OFzqlix0=' 'nonce-{cspNonce}';",
        "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;",
        "connect-src 'self' https: http: ws: wss:;",
        "img-src 'self' data: https: blob:;",
        "font-src 'self' https://fonts.gstatic.com;",
        "object-src 'none';",
        "frame-ancestors 'self';",
        "base-uri 'self';",
        "form-action 'self';");
}

@{
    // Read the language cookie server-side for correct SSR lang/dir attributes.
    // Raw cookie values are never trusted: we resolve through CultureRegistry, which is the
    // compile-time allowlist. Anything outside it degrades to the canonical default ("en").
    var langCookie = HttpContextAccessor.HttpContext?.Request.Cookies["lang"];
    var pageLang = BffCultureRegistry.TryNormalize(langCookie, out var resolvedLanguage)
        ? resolvedLanguage
        : "en";
    var pageDir = BffCultureRegistry.IsRtl(pageLang) ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@pageLang" dir="@pageDir">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta http-equiv="Content-Security-Policy" content="@csp">
	<base href="/" />
	<link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
	<link href="css/layers.css" rel="stylesheet" />
	<link href="Explore.Blazor.styles.css" rel="stylesheet" />
	<link rel="stylesheet" href="_content/Blazouter/blazouter.min.css" />
	<ImportMap nonce="@cspNonce" />
	<link rel="manifest" href="manifest.webmanifest" />
	<meta name="theme-color" content="#2563eb" />
	<link rel="icon" type="image/ico" href="favicon.ico" />
	<HeadOutlet @rendermode="EffectiveRenderMode" />
</head>

<body>
    @{
        var theme = HttpContextAccessor.HttpContext?.Request.Cookies["theme"];
        var isDark = theme == "dark";
    }

	<CascadingAuthenticationState>
        <CascadingValue Value="isDark" Name="InitialTheme">
            <ErrorBoundary>
                <ChildContent>
                    @if (ShouldUseControlPlaneShell())
                    {
                        <EmbeddedControlPlaneRoutes @rendermode="EffectiveRenderMode" />
                    }
                    else
                    {
		                <Routes @rendermode="EffectiveRenderMode" />
                    }
                </ChildContent>
                <ErrorContent Context="ex">
                    @{
                        LogBoundaryError(ex);
                    }
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                            An unexpected error occurred. Please try refreshing the page.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => { })"
                                   Href="/"
                                   Class="mt-2">
                            Return to Home
                        </MudButton>
                    </MudContainer>
                </ErrorContent>
            </ErrorBoundary>
        </CascadingValue>
	</CascadingAuthenticationState>
	<script src="_framework/blazor.web.js"></script>
	<script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
	<script src=@Assets["js/localization.js"]></script>
</body>

</html>

@code {
    private Microsoft.AspNetCore.Components.IComponentRenderMode EffectiveRenderMode { get; set; } =
        new InteractiveServerRenderMode(prerender: true);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var requestPath = HttpContextAccessor.HttpContext?.Request.Path.Value;
            var decision = await RuntimeRenderPolicyService.ResolveForPathAsync(requestPath);
            EffectiveRenderMode = new InteractiveServerRenderMode(prerender: decision.PrerenderEnabled);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to resolve Blazor render policy; using safe InteractiveServer default.");
        }
    }

    private void LogBoundaryError(Exception exception)
    {
        Logger.LogError(exception, "Global Blazor error boundary caught an unhandled component exception.");
    }

    private bool ShouldUseControlPlaneShell()
    {
        return AdminHostShellSelector.ShouldUseControlPlaneShell(HttpContextAccessor.HttpContext);
    }

}
